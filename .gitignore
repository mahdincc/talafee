# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# Compiled TS that leaked next to source config — belongs only in dist/
crawler-service/config/*.js
crawler-service/config/*.d.ts
crawler-service/config/*.map

# Database files
*.db
*.sqlite
*.sqlite3
data/

# Environment files
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Cache
.cache/
.npm/
crawlers/

# Secrets — never commit private keys or SSH material
*.pem
*.key
id_rsa*

# Local Claude Code workspace + agent-managed scratch dirs
.claude/*
# ...but DO commit shared conventions so every clone (and every new chat) sees them
!.claude/conventions/
!.claude/conventions/**
.local-backup-*/
.vps-snapshot/

# Misc local-only
tasks.txt
talafee_server_start.txt

# Local-only competitive/reverse-engineering analysis — keep OUT of the public repo
docs/TALINE-PLATFORM-REPORT.md
